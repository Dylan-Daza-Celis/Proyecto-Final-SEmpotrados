# ESP32-CAM clásica. Se aplican al generar sdkconfig, no lo sobrescriben.
CONFIG_IDF_TARGET="esp32"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
# Permite llegar a app_main para diagnosticar ausencia de PSRAM y detener captura.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Combinación válida y conservadora para JPEG QVGA: flash/PSRAM a 40 MHz.
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Wi-Fi + HTTP rozan el límite de la partición de 1 MiB: usar la tabla oficial
# de aplicación única grande (factory de 1500 KiB), dentro de la flash de 4 MiB.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
